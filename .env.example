# Copy this file for local development. Every value marked "Production: required" must be
# supplied explicitly by the deployment platform; do not deploy these placeholders.

# Application
# Production: required; set both values to production.
APP_ENV=development
NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=3000
# Set true only when the API runs behind a trusted reverse proxy.
API_TRUST_PROXY=false
API_PREFIX=api
API_VERSION=1
# Swagger is enabled outside production and disabled when APP_ENV/NODE_ENV are production.
SWAGGER_PATH=docs
# Production: required; set this to one or more comma-separated exact frontend HTTPS origins.
# Wildcard CORS is not allowed in production.
CORS_ORIGINS=https://ctxaro.com
# JSON and URL-encoded request bodies; repository contents are fetched from GitHub, not uploaded.
REQUEST_BODY_LIMIT_BYTES=32768
# MVP in-memory rate limits. Auth endpoints use the stricter auth limit.
RATE_LIMIT_GLOBAL_TTL_SECONDS=60
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_TTL_SECONDS=60
RATE_LIMIT_AUTH_MAX=10
# Synchronous provider/CPU/database-heavy operations receive a stricter per-client limit.
RATE_LIMIT_EXPENSIVE_TTL_SECONDS=60
RATE_LIMIT_EXPENSIVE_MAX=5
# A RUNNING repository update older than this may be recovered after its repository lock expires.
REPOSITORY_UPDATE_STALE_THRESHOLD_SECONDS=21600

# Web
# Public browser configuration. Never put secrets in any VITE_* variable.
# Production: required, must end in /api/v1, use HTTPS, and not point to localhost.
VITE_API_URL=https://api.ctxaro.com/api/v1
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# GitHub OAuth
# Production: required; replace all placeholder values below.
GITHUB_CLIENT_ID=replace_with_github_oauth_client_id
GITHUB_CLIENT_SECRET=replace_with_github_oauth_client_secret
# Production: must match the GitHub OAuth app callback URL exactly.
GITHUB_CALLBACK_URL=https://api.ctxaro.com/api/v1/auth/github/callback
# Production: must be the frontend HTTPS /auth/callback URL.
WEB_AUTH_CALLBACK_URL=https://ctxaro.com/auth/callback
PROVIDER_TOKEN_ENCRYPTION_KEY=replace_with_at_least_32_random_characters

# JWT
# Production: required; use two distinct generated secrets and replace these placeholders.
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_random_character_secret
JWT_ACCESS_TOKEN_TTL_SECONDS=7200
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# Supabase PostgreSQL
# Use the connection string from Supabase Project Settings > Database.
# Prisma reads this variable through prisma.config.ts.
# Production: required; use the production database URL, not a local database URL.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DATABASE_PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
