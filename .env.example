# Application
APP_ENV=development
NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=3000
API_PREFIX=api
API_VERSION=1
SWAGGER_PATH=docs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase PostgreSQL
# Use the connection string from Supabase Project Settings > Database.
# Prisma reads this variable through prisma.config.ts.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DATABASE_PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
