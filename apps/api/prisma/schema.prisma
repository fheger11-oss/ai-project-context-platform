generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum RepositoryVisibility {
  PUBLIC
  PRIVATE
  INTERNAL
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum DocumentType {
  PROJECT_OVERVIEW
  TECHNICAL_DOCUMENTATION
}

enum DocumentFormat {
  MARKDOWN
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String?        @map("password_hash")
  role          Role           @default(USER)
  tenantId      String?        @map("tenant_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  githubAccount GitHubAccount?
  repositories  Repository[]

  @@index([tenantId])
  @@map("users")
}

model GitHubAccount {
  id                   String   @id @default(cuid())
  userId               String   @unique @map("user_id")
  githubId             String   @unique @map("github_id")
  login                String
  displayName          String?  @map("display_name")
  avatarUrl            String?  @map("avatar_url")
  accessTokenEncrypted String   @map("access_token_encrypted")
  accessTokenIv        String   @map("access_token_iv")
  accessTokenAuthTag   String   @map("access_token_auth_tag")
  scope                String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([login])
  @@map("github_accounts")
}

model RefreshToken {
  id                String    @id @default(cuid())
  tokenHash         String    @unique @map("token_hash")
  userId            String    @map("user_id")
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Repository {
  id              String               @id @default(cuid())
  userId          String               @map("user_id")
  githubId        String               @map("github_id")
  name            String
  fullName        String               @map("full_name")
  owner           String
  description     String?
  defaultBranch   String               @map("default_branch")
  visibility      RepositoryVisibility
  language        String?
  stars           Int                  @default(0)
  forks           Int                  @default(0)
  isArchived      Boolean              @default(false) @map("is_archived")
  cloneUrl        String               @map("clone_url")
  htmlUrl         String               @map("html_url")
  githubUpdatedAt DateTime             @map("github_updated_at")
  lastSyncedAt    DateTime             @default(now()) @map("last_synced_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans Scan[]
  analyses Analysis[]
  projectContexts ProjectContext[]

  @@unique([userId, githubId])
  @@index([userId])
  @@index([fullName])
  @@map("repositories")
}

model Scan {
  id           String     @id @default(cuid())
  repositoryId String     @map("repository_id")
  status       ScanStatus @default(PENDING)
  commitSha    String     @map("commit_sha")
  startedAt    DateTime?  @map("started_at")
  completedAt  DateTime?  @map("completed_at")
  durationMs   Int?       @map("duration_ms")
  totalFiles   Int        @default(0) @map("total_files")
  totalSize    BigInt     @default(0) @map("total_size")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  files      ScanFile[]
  analyses   Analysis[]
  projectContexts ProjectContext[]

  @@index([repositoryId])
  @@index([repositoryId, createdAt, id])
  @@index([status])
  @@index([commitSha])
  @@map("scans")
}

model Analysis {
  id               String         @id
  scanId           String         @map("scan_id")
  repositoryId     String         @map("repository_id")
  status           AnalysisStatus @default(PENDING)
  analyzerVersion  String         @map("analyzer_version")
  commitSha        String         @map("commit_sha")
  generatedAt      DateTime?      @map("generated_at")
  project          Json?
  files            Json?
  sourceStructures Json?          @map("source_structures")
  relationships    Json?
  dependencies     Json?
  issues           Json?
  startedAt        DateTime?      @map("started_at")
  completedAt      DateTime?      @map("completed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  scan       Scan       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  projectContexts ProjectContext[]

  @@index([scanId])
  @@index([repositoryId])
  @@index([scanId, analyzerVersion])
  @@map("analyses")
}

model ProjectContext {
  id             String   @id @default(cuid())
  contextId      String   @map("context_id")
  analysisId     String   @map("analysis_id")
  scanId         String   @map("scan_id")
  repositoryId   String   @map("repository_id")
  commitSha      String   @map("commit_sha")
  contextVersion String   @map("context_version")
  generatedAt    DateTime @map("generated_at")
  snapshot       Json
  createdAt      DateTime @default(now()) @map("created_at")

  analysis   Analysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  scan       Scan       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  documents  Document[]

  @@index([contextId])
  @@index([analysisId, generatedAt, createdAt, id])
  @@index([scanId])
  @@index([repositoryId])
  @@index([contextVersion])
  @@map("project_contexts")
}

model Document {
  id               String         @id @default(cuid())
  projectContextId String         @map("project_context_id")
  contextId        String         @map("context_id")
  documentType     DocumentType   @map("document_type")
  format           DocumentFormat
  generatorVersion String         @map("generator_version")
  content          String         @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")

  projectContext ProjectContext @relation(fields: [projectContextId], references: [id], onDelete: Cascade)

  @@index([projectContextId])
  @@index([contextId])
  @@index([documentType, format])
  @@index([generatorVersion])
  @@map("documents")
}

model ScanFile {
  id        String   @id @default(cuid())
  scanId    String   @map("scan_id")
  path      String
  extension String?
  size      BigInt
  sha       String
  content   String?
  isBinary  Boolean  @default(false) @map("is_binary")
  isHidden  Boolean  @default(false) @map("is_hidden")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, path])
  @@index([scanId])
  @@index([path])
  @@map("scan_files")
}
