generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum RepositoryVisibility {
  PUBLIC
  PRIVATE
  INTERNAL
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ScanLimitFailureReason {
  FILE_COUNT_LIMIT
  INDIVIDUAL_FILE_SIZE_LIMIT
  TOTAL_SIZE_LIMIT
}

enum AnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum DocumentType {
  PROJECT_OVERVIEW
  TECHNICAL_DOCUMENTATION
  ARCHITECTURE_DOCUMENT
  MODULE_DOCUMENTATION
  README
}

enum DocumentFormat {
  MARKDOWN
}

enum FeedbackType {
  FEATURE_REQUEST
  BUG
  CONFUSING
  GENERAL
}

enum RepositoryFreshnessStatus {
  UNKNOWN
  FRESH
  STALE
  UPDATE_FAILED
}

enum RepositoryUpdateStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum RepositoryUpdateTriggerType {
  MANUAL
  WEBHOOK
  SYSTEM
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String?        @map("password_hash")
  role          Role           @default(USER)
  tenantId      String?        @map("tenant_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  githubAccount GitHubAccount?
  repositories  Repository[]
  usageEvents   UsageEvent[]
  feedback      Feedback[]

  @@index([tenantId])
  @@map("users")
}

model GitHubAccount {
  id                   String   @id @default(cuid())
  userId               String   @unique @map("user_id")
  githubId             String   @unique @map("github_id")
  login                String
  displayName          String?  @map("display_name")
  avatarUrl            String?  @map("avatar_url")
  accessTokenEncrypted String   @map("access_token_encrypted")
  accessTokenIv        String   @map("access_token_iv")
  accessTokenAuthTag   String   @map("access_token_auth_tag")
  scope                String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([login])
  @@map("github_accounts")
}

model RefreshToken {
  id                String    @id @default(cuid())
  tokenHash         String    @unique @map("token_hash")
  familyId          String    @map("family_id")
  userId            String    @map("user_id")
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Repository {
  id              String               @id @default(cuid())
  userId          String               @map("user_id")
  githubId        String               @map("github_id")
  name            String
  fullName        String               @map("full_name")
  owner           String
  description     String?
  defaultBranch   String               @map("default_branch")
  visibility      RepositoryVisibility
  language        String?
  stars           Int                  @default(0)
  forks           Int                  @default(0)
  isArchived      Boolean              @default(false) @map("is_archived")
  cloneUrl        String               @map("clone_url")
  htmlUrl         String               @map("html_url")
  githubUpdatedAt DateTime             @map("github_updated_at")
  lastSyncedAt    DateTime             @default(now()) @map("last_synced_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans           Scan[]
  analyses        Analysis[]
  projectContexts ProjectContext[]
  state           RepositoryState?
  updates         RepositoryUpdate[]

  @@unique([userId, githubId])
  @@index([userId])
  @@index([fullName])
  @@map("repositories")
}

model RepositoryState {
  id                      String                    @id @default(cuid())
  repositoryId            String                    @unique @map("repository_id")
  remoteHeadCommitSha     String?                   @map("remote_head_commit_sha")
  remoteHeadCheckedAt     DateTime?                 @map("remote_head_checked_at")
  lastScannedCommitSha    String?                   @map("last_scanned_commit_sha")
  lastAnalyzedCommitSha   String?                   @map("last_analyzed_commit_sha")
  currentProjectContextId String?                   @unique @map("current_project_context_id")
  currentContextCommitSha String?                   @map("current_context_commit_sha")
  freshnessStatus         RepositoryFreshnessStatus @default(UNKNOWN) @map("freshness_status")
  lastUpdateStatus        String?                   @map("last_update_status")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")

  repository            Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  currentProjectContext ProjectContext? @relation("RepositoryStateCurrentProjectContext", fields: [currentProjectContextId], references: [id], onDelete: SetNull)

  @@index([freshnessStatus])
  @@index([lastScannedCommitSha])
  @@index([lastAnalyzedCommitSha])
  @@index([currentContextCommitSha])
  @@map("repository_states")
}

model RepositoryUpdate {
  id               String                      @id @default(cuid())
  repositoryId     String                      @map("repository_id")
  triggerType      RepositoryUpdateTriggerType @map("trigger_type")
  baseCommitSha    String?                     @map("base_commit_sha")
  targetCommitSha  String                      @map("target_commit_sha")
  status           RepositoryUpdateStatus      @default(PENDING)
  startedAt        DateTime?                   @map("started_at")
  completedAt      DateTime?                   @map("completed_at")
  failedAt         DateTime?                   @map("failed_at")
  failureReason    String?                     @map("failure_reason")
  scanId           String?                     @map("scan_id")
  analysisId       String?                     @map("analysis_id")
  projectContextId String?                     @map("project_context_id")
  changeSet        Json?                       @map("change_set")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")

  repository     Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  scan           Scan?           @relation("RepositoryUpdateScan", fields: [scanId], references: [id], onDelete: SetNull)
  analysis       Analysis?       @relation("RepositoryUpdateAnalysis", fields: [analysisId], references: [id], onDelete: SetNull)
  projectContext ProjectContext? @relation("RepositoryUpdateProjectContext", fields: [projectContextId], references: [id], onDelete: SetNull)

  @@index([repositoryId])
  @@index([repositoryId, status])
  @@index([repositoryId, targetCommitSha])
  @@index([createdAt])
  @@map("repository_updates")
}

model Scan {
  id                   String                  @id @default(cuid())
  repositoryId         String                  @map("repository_id")
  status               ScanStatus              @default(PENDING)
  commitSha            String                  @map("commit_sha")
  startedAt            DateTime?               @map("started_at")
  completedAt          DateTime?               @map("completed_at")
  durationMs           Int?                    @map("duration_ms")
  totalFiles           Int                     @default(0) @map("total_files")
  totalSize            BigInt                  @default(0) @map("total_size")
  filesProcessed       Int                     @default(0) @map("files_processed")
  totalBytesConsidered BigInt                  @default(0) @map("total_bytes_considered")
  scanLimitReason      ScanLimitFailureReason? @map("scan_limit_reason")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  repository        Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  files             ScanFile[]
  analyses          Analysis[]
  projectContexts   ProjectContext[]
  repositoryUpdates RepositoryUpdate[] @relation("RepositoryUpdateScan")

  @@index([repositoryId])
  @@index([repositoryId, createdAt, id])
  @@index([status])
  @@index([commitSha])
  @@map("scans")
}

model Analysis {
  id               String         @id
  scanId           String         @map("scan_id")
  repositoryId     String         @map("repository_id")
  status           AnalysisStatus @default(PENDING)
  analyzerVersion  String         @map("analyzer_version")
  commitSha        String         @map("commit_sha")
  generatedAt      DateTime?      @map("generated_at")
  project          Json?
  files            Json?
  sourceStructures Json?          @map("source_structures")
  relationships    Json?
  dependencies     Json?
  issues           Json?
  startedAt        DateTime?      @map("started_at")
  completedAt      DateTime?      @map("completed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  scan              Scan               @relation(fields: [scanId], references: [id], onDelete: Cascade)
  repository        Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  projectContexts   ProjectContext[]
  repositoryUpdates RepositoryUpdate[] @relation("RepositoryUpdateAnalysis")

  @@index([scanId])
  @@index([repositoryId])
  @@index([scanId, analyzerVersion])
  @@map("analyses")
}

model ProjectContext {
  id             String   @id @default(cuid())
  contextId      String   @map("context_id")
  analysisId     String   @map("analysis_id")
  scanId         String   @map("scan_id")
  repositoryId   String   @map("repository_id")
  commitSha      String   @map("commit_sha")
  contextVersion String   @map("context_version")
  generatedAt    DateTime @map("generated_at")
  snapshot       Json
  createdAt      DateTime @default(now()) @map("created_at")

  analysis                   Analysis           @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  scan                       Scan               @relation(fields: [scanId], references: [id], onDelete: Cascade)
  repository                 Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  documents                  Document[]
  currentForRepositoryStates RepositoryState[]  @relation("RepositoryStateCurrentProjectContext")
  repositoryUpdates          RepositoryUpdate[] @relation("RepositoryUpdateProjectContext")

  @@index([contextId])
  @@index([analysisId, generatedAt, createdAt, id])
  @@index([scanId])
  @@index([repositoryId])
  @@index([contextVersion])
  @@map("project_contexts")
}

model Document {
  id               String         @id @default(cuid())
  projectContextId String         @map("project_context_id")
  contextId        String         @map("context_id")
  documentType     DocumentType   @map("document_type")
  format           DocumentFormat
  generatorVersion String         @map("generator_version")
  content          String         @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")

  projectContext ProjectContext @relation(fields: [projectContextId], references: [id], onDelete: Cascade)

  @@index([projectContextId])
  @@index([contextId])
  @@index([documentType, format])
  @@index([generatorVersion])
  @@map("documents")
}

model OperationLock {
  key           String   @id
  operationType String   @map("operation_type")
  ownerId       String   @map("owner_id")
  acquiredAt    DateTime @default(now()) @map("acquired_at")
  expiresAt     DateTime @map("expires_at")

  @@index([operationType])
  @@index([ownerId])
  @@index([expiresAt])
  @@map("operation_locks")
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  resource  String
  createdAt DateTime @default(now()) @map("created_at")
  metadata  Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, resource, createdAt])
  @@map("usage_events")
}

model Feedback {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  type      FeedbackType
  message   String       @db.Text
  page      String?
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("feedback")
}

model ScanFile {
  id        String   @id @default(cuid())
  scanId    String   @map("scan_id")
  path      String
  extension String?
  size      BigInt
  sha       String
  content   String?
  isBinary  Boolean  @default(false) @map("is_binary")
  isHidden  Boolean  @default(false) @map("is_hidden")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, path])
  @@index([scanId])
  @@index([path])
  @@map("scan_files")
}
