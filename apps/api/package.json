{
  "name": "@ai-context/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:generate && tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "pnpm db:generate && tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier . --write",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "rm -rf src/generated/prisma && prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "clean": "rm -rf dist src/generated/prisma"
  },
  "dependencies": {
    "@ai-context/contracts": "workspace:*",
    "@ai-context/shared": "workspace:*",
    "@ai-context/types": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsx": "^4.23.5"
  }
}
